#!/usr/bin/env python3
"""Print a fingerprint of a secret (short sha256 and length), never the value.

  secret-fp NAME        from the environment, else from this project's .env files
  secret-fp --all       every secret in this project's .env files
  ... | secret-fp -     from stdin (one trailing newline is ignored)

Two values with the same fingerprint are identical.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import secret_guard as sg  # noqa: E402


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 1
    if argv[0] == "-":
        value = sys.stdin.read()
        value = value[:-1] if value.endswith("\n") else value
        print(f"stdin  {sg.fingerprint(value)}")
        return 0
    files = sg.find_env_files(os.getcwd())
    if argv[0] == "--all":
        for path in files:
            for name, value in sg.parse_env_file(path).items():
                if sg.is_secret(name, value):
                    print(f"{name}  {sg.fingerprint(value)}  {os.path.relpath(path)}")
        return 0
    status = 0
    for name in argv:
        hits = [("environment", os.environ[name])] if name in os.environ else []
        hits += [(os.path.relpath(p), env[name]) for p in files for env in [sg.parse_env_file(p)] if name in env]
        if not hits:
            print(f"{name}  not set", file=sys.stderr)
            status = 1
        for source, value in hits:
            print(f"{name}  {sg.fingerprint(value)}  {source}")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
