#!/usr/bin/env python3
"""Mask secrets in stdin.  redact [--stream] [--cwd DIR] < input"""

import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import secret_guard as sg  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--stream", action="store_true", help="flush after every line")
    ap.add_argument("--cwd", action="append", help="folder to read .env files from (repeatable)")
    args = ap.parse_args()
    r = sg.Redactor.for_cwd(args.cwd or [os.getcwd()])
    stdin = open(sys.stdin.fileno(), encoding="utf-8", errors="replace", newline="")
    for line in r.redact_lines(stdin):
        sys.stdout.write(line)
        if args.stream:
            sys.stdout.flush()


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
